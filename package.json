{
  "name": "discord-vc-summary",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:bot": "bun apps/bot/src/index.ts",
    "dev:worker": "bun apps/worker/src/index.ts",
    "db:migrate": "bun scripts/database-migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build:audio": "bun scripts/audio-build.ts",
    "test:audio": "bun --no-env-file scripts/audio-smoke.ts",
    "test:pipeline": "bun --no-env-file scripts/audio-pipeline-smoke.ts",
    "check:audio": "bun --no-env-file scripts/check-audio.ts"
  },
  "devDependencies": {
    "@types/bun": "^1",
    "typescript": "^5.9",
    "@napi-rs/cli": "^3"
  }
}
